{
  "name": "takhti",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm --filter @takhti/web dev",
    "build": "pnpm --filter @takhti/web build",
    "worker": "tsx --env-file-if-exists=.env.local packages/worker/src/main.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:studio": "node -e \"console.log('Supabase Studio: http://localhost:64323   Mail catcher: http://localhost:64324')\"",
    "db:env": "tsx packages/db/src/scripts/local-env.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local packages/db/src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local packages/db/src/seed/run.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local packages/db/src/scripts/reset.ts",
    "db:backup": "tsx --env-file-if-exists=.env.local packages/db/src/scripts/backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env.local packages/db/src/scripts/restore.ts",
    "db:custom-sql": "tsx packages/db/src/scripts/custom-sql.ts",
    "db:lint": "vitest run tests/db tests/lint/generated.test.ts",
    "db:verify-plan": "tsx packages/db/src/scripts/verify-plan.ts",
    "db:verify-seed": "tsx --env-file-if-exists=.env.local packages/db/src/scripts/verify-seed.ts",
    "db:seed-stats": "tsx --env-file-if-exists=.env.local packages/db/src/scripts/seed-stats.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx --env-file-if-exists=.env.local tests/helpers/run-on-postgres.ts",
    "smoke": "tsx --env-file-if-exists=.env.local tests/smoke/local.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "plan:check": "node docs/plan/_tools/check.mjs",
    "scaffold": "node docs/plan/_tools/scaffold.mjs",
    "scaffold:api": "tsx docs/plan/_tools/scaffold-api.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@takhti/api-client": "workspace:*",
    "@takhti/config": "workspace:*",
    "@takhti/contracts": "workspace:*",
    "@takhti/core": "workspace:*",
    "@takhti/db": "workspace:*",
    "@takhti/eslint-config": "workspace:*",
    "@takhti/hooks": "workspace:*",
    "@takhti/worker": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "10.12.0",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
