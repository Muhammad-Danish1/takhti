# Copy to .env.local and fill in. The app refuses to start if a value is missing or malformed
# (packages/core/src/kernel/env.ts). Nothing in .env.local is ever committed.

# --- the web app
APP_URL=http://localhost:3000
APP_ENV=local

# --- Supabase (`pnpm db:env` fills these in from the running local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Postgres
# The API connects as `takhti_api`, a role that cannot bypass row-level security.
DATABASE_URL=postgres://takhti_api:change-me-locally@127.0.0.1:64322/postgres
# Migrations, seed, the worker's job claiming and platform services use the privileged connection.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:64322/postgres
# `pnpm db:reset` sets the takhti_api password to this value.
TAKHTI_API_DB_PASSWORD=change-me-locally

# --- secrets
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- outside services: local stand-ins
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
EMAIL_PROVIDER=log
PUSH_PROVIDER=log
PAYMENT_PROVIDER=fake
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=            only with AI_PROVIDER=anthropic

# --- logging and tests
LOG_LEVEL=debug
# pglite (default, in-process) or postgres (the Docker database, used by `pnpm test:db`)
TEST_DB=pglite
